# Copy to .env and change the passwords before the first "docker compose up".
TEMPORAL_DB_PASSWORD=change-me-temporal
VMINTENT_DB_PASSWORD=change-me-vmintent

# How many worker containers to start (change any time with --scale worker=N).
WORKERS=3

# Image versions
TEMPORAL_VERSION=1.29.7
TEMPORAL_UI_VERSION=2.40.0

# Optional AI interpreter: none (built-in rules), anthropic, openai, azure-openai or ollama.
# The rules still answer whenever the AI can't. See README "Using an AI".
VMINTENT_LLM_PROVIDER=none
VMINTENT_LLM_MODEL=
VMINTENT_LLM_URL=
VMINTENT_LLM_API_KEY=
# Local Ollama in Docker: VMINTENT_LLM_PROVIDER=ollama, VMINTENT_LLM_URL=http://ollama:11434,
# then start it with: docker compose --profile ollama up -d

# API sign-in (docs/SECURITY.md): none, entra, pki or entra,pki.
# "none" leaves the API open: keep it on a private network.
VMINTENT_SECURITY_MODE=none
# For VMINTENT_SECURITY_MODE=entra:
VMINTENT_ENTRA_TENANT_ID=
VMINTENT_ENTRA_AUDIENCES=api://vm-intent
# Optional: client ID of a SPA app registration, for the "Authorize" button in Swagger UI.
VMINTENT_SWAGGER_CLIENT_ID=

# Client certificates (VMINTENT_SECURITY_MODE=pki or entra,pki). Put the files in deploy/pki/.
# HTTPS on port 8443, asking callers for a certificate:
#VMINTENT_API_PROFILES=api,tls
#VMINTENT_WEB_API_UPSTREAM=https://api:8443
# Optional: refuse revoked certificates (put the CRLs in deploy/pki/crl.pem).
#VMINTENT_PKI_CRL_FILE=/etc/vm-intent/pki/crl.pem
# Optional: a TLS proxy in front of the API forwards the certificate in a header.
#VMINTENT_PKI_HEADER=X-Client-Cert
#VMINTENT_PKI_TRUSTED_PROXIES=10.40.1.10
