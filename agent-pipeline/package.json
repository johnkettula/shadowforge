{
  "name": "vm-intent-agent-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic pipeline that writes requirements for vm-intent, builds them, deploys, tests, reviews, merges and redesigns, as a Temporal workflow.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "worker": "tsx src/worker.ts",
    "start": "tsx src/cli.ts start",
    "ctl": "tsx src/cli.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/common": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.25.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
